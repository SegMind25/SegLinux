#!/bin/bash
# seglinux-upgrade: brings an installed SegLinux up to the newest SegLinux,
# as a new ISO would: its desktop, design, settings, performance tuning and
# applications, with Artix's packages and Brave (from the AUR). Every
# package from a repository is signature-checked by pacman.
#
#   sudo seglinux-upgrade                 upgrade everything
#   sudo seglinux-upgrade --noconfirm     ... without questions (any pacman option)
#   sudo seglinux-upgrade --setup         only set up the repositories (Setup)
#   sudo seglinux-upgrade --from-source   build SegLinux from its newest source
#
# (seglinux-update is the same command, by its former name.) A system
# installed from an ISO older than this command gets it once with
# (docs/updating.md), and from then on has `sudo seglinux-upgrade`:
#   curl -fsSL https://raw.githubusercontent.com/SegMind25/SegLinux/main/data/system/seglinux-upgrade -o /tmp/seglinux-upgrade && sudo bash /tmp/seglinux-upgrade
set -euo pipefail

updates=https://github.com/SegMind25/SegLinux/releases/download/packages
conf=/etc/pacman.conf
defaults=/usr/share/seglinux/default-apps
offered=/var/lib/seglinux/offered-apps
source_url=https://github.com/SegMind25/SegLinux
api=https://api.github.com/repos/SegMind25/SegLinux
packaged=/usr/bin/seglinux-upgrade
local_copy=/usr/local/bin/seglinux-upgrade

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWarning:\033[0m %s\n' "$*" >&2; }
die() { printf 'seglinux-upgrade: %s\n' "$*" >&2; exit 1; }

has_repo() { grep -q "^\[$1\]" "$conf"; }

# Adds the repository $1, with the lines that follow, at the end of pacman.conf.
add_repo() {
    local name=$1
    shift
    cp -p "$conf" "$conf.before-seglinux-update"
    {
        printf '\n# Added by seglinux-update.\n[%s]\n' "$name"
        printf '%s\n' "$@"
    } >> "$conf"
}

# The one-time download (above) leaves the command installed, so that
# `sudo seglinux-upgrade` works from then on, until the seglinux package
# brings its own; that one then replaces it (retire_local_copy).
install_command() {
    local self=${BASH_SOURCE[0]}
    [[ -e $packaged || $(realpath "$self") == "$local_copy" ]] && return 0
    install -Dm755 "$self" "$local_copy"
    ln -sfn seglinux-upgrade "${local_copy%/*}/seglinux-update"
    say "Installed the seglinux-upgrade command: from now on, upgrade with  sudo seglinux-upgrade"
}

# /usr/local/bin comes first in the PATH: the copies would hide the
# package's newer command.
retire_local_copy() {
    local copy
    [[ -e $packaged ]] || return 0
    for copy in "$local_copy" "${local_copy%/*}/seglinux-update"; do
        if [[ -L $copy ]] || { [[ -f $copy ]] && grep -q '^# seglinux-up\(date\|grade\): ' "$copy"; }; then
            rm -f "$copy"
        fi
    done
}

# pacman's own key, which signing other keys needs; Setup creates it, but a
# system whose keyring was never set up (or was reset) has none.
ensure_keyring() {
    if [[ -z $(ls -A /etc/pacman.d/gnupg/private-keys-v1.d 2>/dev/null) ]]; then
        say "Setting up pacman's keyring"
        pacman-key --init
        pacman-key --populate
    fi
}

# A repository whose server is gone (one added by hand that its author took
# down, say) stops every update: "failed to synchronize all databases". Such
# a repository, with a Server line of its own, is turned off (commented out;
# pacman.conf.before-seglinux-update keeps the previous file).
disable_dead_repos() {
    local arch repo url code
    arch=$(uname -m)
    while read -r repo url; do
        url=${url//\$repo/$repo}
        url=${url//\$arch/$arch}
        code=$(curl -sL -o /dev/null -w '%{http_code}' --max-time 20 "$url/$repo.db" || true)
        [[ $code == 404 || $code == 410 || $code == 000 ]] || continue
        warn "the repository [$repo] is gone ($url answers $code): turned off in $conf."
        cp -p "$conf" "$conf.before-seglinux-update"
        awk -v r="[$repo]" '/^\[/ {s = ($0 == r)} s && NF && !/^#/ {$0 = "#" $0} {print}' "$conf" > "$conf.new"
        cat "$conf.new" > "$conf" && rm -f "$conf.new"
    done < <(awk '/^\[/ {r = substr($0, 2, length($0) - 2)}
        r != "options" && r != "seglinux" && !seen[r] && /^[ \t]*Server[ \t]*=/ {
            seen[r] = 1; sub(/^[^=]*=[ \t]*/, ""); print r, $0 }' "$conf")
}

# Chaotic-AUR served only Brave, but its package list (several MB) came down
# on every update. Brave now comes from the AUR (aur_install); the
# repository, its comments and its keyring and mirror list go.
retire_chaotic() {
    has_repo chaotic-aur || return 0
    say "Removing Chaotic-AUR (a large download on every update, only for Brave)"
    cp -p "$conf" "$conf.before-seglinux-update"
    awk '/^#?\[/ {skip = ($0 == "[chaotic-aur]"); if (skip) {buf = ""; next}}
        /^#/ && !/^#\[/ && !skip {buf = buf $0 "\n"; next}
        {if (!skip) {printf "%s", buf; print}; buf = ""}
        END {printf "%s", buf}' "$conf" > "$conf.new"
    cat "$conf.new" > "$conf" && rm -f "$conf.new"
    local name installed=()
    for name in chaotic-keyring chaotic-mirrorlist; do
        pacman -Q "$name" >/dev/null 2>&1 && installed+=("$name")
    done
    ((${#installed[@]} == 0)) || pacman -R --noconfirm "${installed[@]}" >/dev/null || true
}

# The AUR's version of package $1 (empty when the AUR cannot be reached).
aur_version() {
    curl -fsS --max-time 20 "https://aur.archlinux.org/rpc/v5/info?arg%5B%5D=$1" |
        sed -n 's/.*"Version":"\([^"]*\)".*/\1/p'
}

# Installs or updates the AUR packages named, when the AUR has a newer
# version, built with makepkg from the account that ran sudo. brave-bin
# repackages Brave's own build: a download, no compiling.
aur_install() {
    local user=${SUDO_USER:-} home name version have work packages
    if [[ -z $user || $user == root ]]; then
        warn "$* comes from the AUR and is built from your account: run  sudo seglinux-upgrade  as yourself, not as root."
        return 0
    fi
    home=$(getent passwd "$user" | cut -d: -f6)
    for name in "$@"; do
        version=$(aur_version "$name" || true)
        if [[ -z $version ]]; then
            warn "$name: the AUR cannot be reached; not updated this time."
            continue
        fi
        have=$(pacman -Q "$name" 2>/dev/null | awk '{print $2}' || true)
        [[ -n $have ]] && (($(vercmp "$have" "$version") >= 0)) && continue
        say "$name $version (AUR)"
        work=$(mktemp -d /var/tmp/seglinux-aur.XXXXXX)
        if ! curl -fsSL "https://aur.archlinux.org/cgit/aur.git/snapshot/$name.tar.gz" | tar -C "$work" -xz; then
            rm -rf "$work"
            warn "$name: its AUR recipe could not be downloaded; not updated this time."
            continue
        fi
        chown -R "$user:" "$work"
        # shellcheck disable=SC2046 # one package name per word
        if pacman -S --needed --noconfirm --asdeps base-devel $(cd "$work/$name" &&
            runuser -u "$user" -- env HOME="$home" makepkg --printsrcinfo |
            sed -n 's/^\t\(make\)\{0,1\}depends = //p') &&
            (cd "$work/$name" && runuser -u "$user" -- env HOME="$home" makepkg -f --noconfirm); then
            packages=("$work/$name/$name"-[0-9]*.pkg.tar.zst)
            pacman -U --noconfirm "${packages[0]}" || warn "$name $version was not installed."
        else
            warn "$name $version did not build; it stays as it is."
        fi
        rm -rf "$work"
    done
}

# SegLinux's own repository. Its key comes with the seglinux package; a
# SegLinux older than signed updates takes it from where the updates are
# published (over HTTPS, like the ISO), once. With $1 = offline, only the
# packaged key is used.
setup_seglinux() {
    local keyring=/usr/share/pacman/keyrings/seglinux.gpg key fpr
    if [[ -f $keyring ]]; then
        pacman-key --populate seglinux >/dev/null
    elif [[ ${1:-} == offline ]]; then
        return 0
    elif ! has_repo seglinux; then
        key=$(mktemp)
        # Quietly: until the signed packages are published, SegLinux is
        # built from its source further on (build_seglinux).
        if ! curl -fsL "$updates/seglinux.gpg" -o "$key"; then
            rm -f "$key"
            say "SegLinux's signed packages are not published yet: SegLinux will be built from its source after the system upgrade."
            return 0
        fi
        fpr=$(gpg --batch --show-keys --with-colons "$key" 2>/dev/null | awk -F: '/^fpr/ {print $10; exit}')
        [[ -n $fpr ]] || die "the SegLinux key from $updates is not a key"
        pacman-key --add "$key" >/dev/null
        pacman-key --lsign-key "$fpr" >/dev/null
        rm -f "$key"
    fi
    has_repo seglinux || add_repo seglinux "Server = $updates"
}

# Packages a newer release replaces in a way pacman asks about, defaulting
# to "no" (and with --noconfirm, stopping): Plasma 6.8 dropped its X11
# session, which plasma-workspace now conflicts with. Plasma on Wayland and
# the SegLinux desktop stay.
retire_replaced() {
    local name by
    while read -r name by; do
        if pacman -Q "$name" >/dev/null 2>&1 &&
            pacman -Si "$by" 2>/dev/null | sed -n 's/^Conflicts With *: //p' | grep -qw "$name"; then
            say "Removing $name: the newer $by replaces it"
            pacman -Rdd --noconfirm "$name"
        fi
    done <<'LIST'
plasma-x11-session plasma-workspace
LIST
}

# SegLinux's newest version, numbered as its published packages are
# (0.1.0.<commits on main>), and the commit to build: "VERSION COMMIT".
latest() {
    local sha count auth=()
    # A token raises GitHub's limit of 60 questions an hour (CI uses one).
    [[ -n ${GITHUB_TOKEN:-} ]] && auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
    if [[ -n ${SEGLINUX_SOURCE:-} ]]; then
        echo "${SEGLINUX_VERSION:-0.1.0.$(git -C "$SEGLINUX_SOURCE" rev-list --count HEAD)} local"
        return
    fi
    sha=$(curl -fsS "${auth[@]}" -H 'Accept: application/vnd.github.sha' "$api/commits/main") || return 1
    count=$(curl -fsSI "${auth[@]}" "$api/commits?sha=$sha&per_page=1" | tr -d '\r' |
        sed -n 's/.*[?&]page=\([0-9]*\)>; rel="last".*/\1/p')
    [[ $sha =~ ^[0-9a-f]{40}$ && $count =~ ^[0-9]+$ ]] || return 1
    echo "0.1.0.$count $sha"
}

# SegLinux itself, built on this computer from its source on GitHub, the way
# AUR packages are, while its signed packages are not published: the
# desktop, Settings, sign-in screen, themes and tuning the newest ISO has.
# makepkg does not build as root, so it builds as the account that ran sudo.
build_seglinux() {
    local user home version sha installed work top deps packages
    local segctl_dir segctl_version segctl_deps segctl_packages=()
    user=${SUDO_USER:-}
    if [[ -z $user || $user == root ]]; then
        warn "SegLinux itself is built from your account: run  sudo seglinux-upgrade  as yourself, not as root."
        return 0
    fi
    if ! read -r version sha < <(latest); then
        warn "Cannot find SegLinux's newest version (is github.com reachable?); SegLinux itself is not upgraded this time."
        return 0
    fi
    [[ $version =~ ^[0-9][0-9.]*$ ]] || die "invalid version: $version"
    installed=$(pacman -Q seglinux 2>/dev/null | awk '{print $2}' || true)
    if [[ -n $installed ]] && (($(vercmp "$installed" "$version") >= 0)); then
        say "SegLinux $installed is the newest"
        return 0
    fi
    if (($(df --output=avail -k /var/tmp | tail -n 1) < 4000000)); then
        warn "Building SegLinux needs 4 GB free in /var/tmp; SegLinux itself is not upgraded this time."
        return 0
    fi
    say "Building SegLinux $version from its source (a few minutes, once per new version)"
    home=$(getent passwd "$user" | cut -d: -f6)
    work=$(mktemp -d /var/tmp/seglinux-build.XXXXXX)
    mkdir "$work/x"
    if [[ $sha == local ]]; then
        tar -C "$SEGLINUX_SOURCE" --exclude=./target --exclude=./.git --exclude=./iso/out \
            --transform "s,^\.,seglinux-$version," -czf "$work/seglinux-$version.tar.gz" .
        tar -C "$work/x" -xzf "$work/seglinux-$version.tar.gz"
    else
        curl -fsSL "$source_url/archive/$sha.tar.gz" -o "$work/source.tar.gz" || {
            rm -rf "$work"
            warn "Cannot download SegLinux's source; SegLinux itself is not upgraded this time."
            return 0
        }
        tar -C "$work/x" -xzf "$work/source.tar.gz"
        # GitHub's archive holds one folder, SegLinux-<commit>.
        top=$(cd "$work/x" && echo *)
        mv "$work/x/$top" "$work/x/seglinux-$version"
        tar -C "$work/x" -czf "$work/seglinux-$version.tar.gz" "seglinux-$version"
    fi
    cp "$work/x/seglinux-$version/packaging/seglinux/"{PKGBUILD,seglinux.install} "$work/"
    # seg, the system tool (package segctl: seg game, the zram and tuning
    # services), is built from the same source: its recipe, and its folder as
    # the source tarball the recipe names.
    segctl_dir=
    if [[ -f $work/x/seglinux-$version/pkg/segctl/PKGBUILD ]]; then
        segctl_dir=$work/segctl
        mkdir "$segctl_dir"
        cp "$work/x/seglinux-$version/pkg/segctl/"{PKGBUILD,segctl.install} "$segctl_dir/"
        segctl_version=$(sed -n 's/^pkgver=//p' "$segctl_dir/PKGBUILD")
        tar -C "$work/x/seglinux-$version" --transform "s,^\./tools/seg,segctl-$segctl_version/tools/seg," \
            -czf "$segctl_dir/segctl-$segctl_version.tar.gz" ./tools/seg
    fi
    rm -rf "$work/x" "$work/source.tar.gz"
    sed -i "s/^pkgver=.*/pkgver=$version/" "$work/PKGBUILD"
    chown -R "$user:" "$work"
    as_user_in() {
        local dir=$1
        shift
        (cd "$dir" && runuser -u "$user" -- env HOME="$home" CARGO_HOME="$home/.cache/seglinux/cargo" "$@")
    }
    as_user() { as_user_in "$work" "$@"; }
    # What it needs to build and run, as dependencies (pacman -Qdt lists
    # them once nothing needs them).
    deps=$(as_user makepkg --printsrcinfo | sed -n 's/^\t\(make\)\{0,1\}depends = //p') || {
        rm -rf "$work"
        warn "SegLinux's build recipe could not be read; SegLinux itself is not upgraded this time."
        return 0
    }
    segctl_deps=
    if [[ -n $segctl_dir ]]; then
        segctl_deps=$(as_user_in "$segctl_dir" makepkg --printsrcinfo | sed -n 's/^\t\(make\)\{0,1\}depends = //p') || segctl_dir=
    fi
    # shellcheck disable=SC2086 # one package name per word
    pacman -S --needed --noconfirm --asdeps base-devel $deps $segctl_deps || {
        rm -rf "$work"
        warn "The tools to build SegLinux could not be installed; SegLinux itself is not upgraded this time."
        return 0
    }
    if ! as_user makepkg -f --nocheck --noconfirm; then
        rm -rf "$work"
        warn "SegLinux $version did not build; your SegLinux stays as it is. Please report it: $source_url/issues"
        return 0
    fi
    # seg is a smaller extra: if it does not build, SegLinux is still upgraded.
    if [[ -n $segctl_dir ]]; then
        if as_user_in "$segctl_dir" makepkg -f --nocheck --noconfirm; then
            segctl_packages=("$segctl_dir"/segctl-*.pkg.tar.zst)
        else
            warn "seg (the segctl package) did not build; it is not upgraded this time."
        fi
    fi
    packages=("$work"/seglinux-"$version"-*.pkg.tar.zst)
    pacman -U "$@" "${packages[0]}" "${segctl_packages[@]}" || warn "SegLinux $version was not installed."
    rm -rf "$work"
}

# Whether SegLinux's signed repository is set up and serves SegLinux.
seglinux_published() {
    has_repo seglinux && pacman -Si seglinux >/dev/null 2>&1
}

# Applications a newer SegLinux installs by default, offered once each: one
# removed on purpose is not installed again.
install_new_defaults() {
    [[ -f $defaults ]] || return 0
    mkdir -p "${offered%/*}"
    touch "$offered"
    local name wanted=()
    while read -r name; do
        [[ -z $name || $name == \#* ]] && continue
        grep -qxF "$name" "$offered" && continue
        pacman -Q "$name" >/dev/null 2>&1 && continue
        # Not in a repository (brave-bin): from the AUR.
        if pacman -Si "$name" >/dev/null 2>&1; then wanted+=("$name"); else aur_install "$name"; fi
    done < "$defaults"
    if ((${#wanted[@]})); then
        say "New default applications: ${wanted[*]}"
        pacman -S --needed "$@" "${wanted[@]}" ||
            warn "Not installed. To install them later: sudo pacman -S ${wanted[*]}"
    fi
    awk 'NF && !/^#/' "$defaults" | sort -u - "$offered" -o "$offered"
}

# SegLinux's own sign-in screen (seglinux-greeter on greetd) replaced SDDM.
# A system installed before is asked once, interactively; the change takes
# effect at the next restart (OpenRC and dinit; runit: docs/desktop.md).
offer_sign_in_screen() {
    local init answer user
    [[ -x /usr/bin/seglinux-greeter ]] || return 0
    if [[ -x /usr/bin/openrc-run ]]; then
        init=openrc
        [[ -e /etc/runlevels/default/sddm ]] || return 0
    elif [[ -d /etc/dinit.d/boot.d ]]; then
        init=dinit
        [[ -e /etc/dinit.d/boot.d/sddm ]] || return 0
    else
        return 0
    fi
    grep -qxF sign-in-screen "$offered" 2>/dev/null && return 0
    [[ -t 0 && " $* " != *" --noconfirm "* ]] || return 0
    say "SegLinux has a new sign-in screen of its own, in place of SDDM"
    read -r -p "Switch to it? It appears at the next restart. [Y/n] " answer || answer=n
    mkdir -p "${offered%/*}"
    echo sign-in-screen >> "$offered"
    if [[ $answer == [nN]* ]]; then
        echo "SDDM stays. To switch later, see docs/desktop.md (Sign-in screen)."
        return 0
    fi
    # SDDM's service goes first: its package (sddm-openrc, sddm-dinit)
    # conflicts with greetd's, and pacman's default answer would keep it.
    case $init in
        openrc) rc-update del sddm default >/dev/null ;;
        dinit) rm -f /etc/dinit.d/boot.d/sddm ;;
    esac
    if pacman -Q "sddm-$init" >/dev/null 2>&1; then
        pacman -Rdd --noconfirm "sddm-$init" >/dev/null
    fi
    if ! pacman -S --needed --noconfirm greetd "greetd-$init"; then
        warn "greetd could not be installed; SDDM stays."
        pacman -S --needed --noconfirm "sddm-$init" >/dev/null || true
        case $init in
            openrc) rc-update add sddm default >/dev/null ;;
            dinit) ln -sfn ../sddm /etc/dinit.d/boot.d/sddm ;;
        esac
        return 0
    fi
    [[ -f /etc/greetd/config.toml ]] && cp -p /etc/greetd/config.toml /etc/greetd/config.toml.before-seglinux
    # The sign-in screen at every start: no automatic sign-in.
    cp /usr/share/seglinux/greeter/greetd.toml /etc/greetd/config.toml
    install -d -m 755 -o greeter -g greeter /var/lib/seglinux-greeter
    user=$(sed -n 's/^User=//p' /var/lib/sddm/state.conf 2>/dev/null | head -n 1 || true)
    if [[ -n $user && ! -e /var/lib/seglinux-greeter/state.toml ]]; then
        printf 'user = "%s"\nsession = "seglinux"\n' "$user" > /var/lib/seglinux-greeter/state.toml
        chown greeter:greeter /var/lib/seglinux-greeter/state.toml
    fi
    case $init in
        openrc) rc-update add greetd default >/dev/null ;;
        dinit) ln -sfn ../greetd /etc/dinit.d/boot.d/greetd ;;
    esac
    say "The new sign-in screen appears at the next restart (to go back: docs/desktop.md)."
}

main() {
    # --from-source is this command's; the rest is for pacman.
    local from_source=false arg args=()
    for arg in "$@"; do
        if [[ $arg == --from-source ]]; then from_source=true; else args+=("$arg"); fi
    done
    set -- "${args[@]}"
    case ${1:-} in
        -h | --help)
            sed -n '2,16s/^# \{0,1\}//p' "$0"
            exit 0
            ;;
    esac
    [[ $EUID == 0 ]] || die "run it as root: sudo seglinux-upgrade"

    if [[ ${1:-} == --setup ]]; then
        setup_seglinux offline
        exit 0
    fi

    install_command
    if [[ -e /var/lib/pacman/db.lck ]]; then
        die "pacman is busy: another update (or Discover) is running. Wait for it to finish and try again. If nothing is running, remove the stale lock with: sudo rm /var/lib/pacman/db.lck"
    fi
    # Any answer at all means the network works (no -f).
    if ! curl -s --max-time 20 -o /dev/null https://github.com; then
        die "no internet connection (github.com cannot be reached). Connect, with Network in the dock or nmtui, and try again."
    fi

    ensure_keyring
    disable_dead_repos
    retire_chaotic
    setup_seglinux
    local before
    before=$(pacman -Q seglinux 2>/dev/null || echo 'seglinux not installed')
    say "Upgrading the system"
    pacman -Sy
    retire_replaced
    pacman -Su "$@"
    if pacman -Q brave-bin >/dev/null 2>&1; then aur_install brave-bin; fi
    if $from_source || ! seglinux_published; then
        build_seglinux "$@"
    fi
    install_new_defaults "$@"
    offer_sign_in_screen "$@"
    retire_local_copy
    local after
    after=$(pacman -Q seglinux 2>/dev/null || echo 'seglinux not installed')
    say "SegLinux is up to date: $after"
    if [[ $after != "$before" ]]; then
        say "Sign out and back in (or restart) to use the new SegLinux."
    fi
}

if [[ -z ${BASH_SOURCE[0]:-} ]]; then
    # Piped into bash, pacman's questions would read the rest of the script.
    die "download it first, then run it: curl -fsSL https://raw.githubusercontent.com/SegMind25/SegLinux/main/data/system/seglinux-upgrade -o /tmp/seglinux-upgrade && sudo bash /tmp/seglinux-upgrade"
elif [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
# (Tests, in ci.yml, source this file for its functions.)
