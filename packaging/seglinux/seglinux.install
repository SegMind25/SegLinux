# The key SegLinux's updates are signed with, once pacman has a keyring
# (SegLinux Setup creates the installed system's).
trust_update_key() {
    if [[ -f /usr/share/pacman/keyrings/seglinux.gpg && -d /etc/pacman.d/gnupg ]]; then
        pacman-key --populate seglinux >/dev/null 2>&1 || true
    fi
}

# Where the sign-in screen remembers the last account and desktop; greetd's
# greeter user must be able to write it.
greeter_state() {
    if getent passwd greeter >/dev/null 2>&1; then
        install -d -m 755 -o greeter -g greeter /var/lib/seglinux-greeter 2>/dev/null || true
    fi
}

# The copies of seglinux-upgrade that its one-time download leaves on
# systems older than it (/usr/local/bin, first in the PATH) would hide this
# package's.
retire_update_copy() {
    local copy
    for copy in /usr/local/bin/seglinux-upgrade /usr/local/bin/seglinux-update; do
        if [[ -L $copy ]] || { [[ -f $copy ]] && grep -q '^# seglinux-up\(date\|grade\): ' "$copy"; }; then
            rm -f "$copy"
        fi
    done
}

post_install() {
    /usr/lib/seglinux/apply-branding
    trust_update_key
    greeter_state
    retire_update_copy
    cat <<'MSG'
==> Windows programs: double-click an .exe, or run `segrun program.exe`.
==> `segrun doctor` checks Wine, Vulkan, NTSYNC and binfmt support.
MSG
}

post_upgrade() {
    /usr/lib/seglinux/apply-branding
    trust_update_key
    greeter_state
    retire_update_copy
}
