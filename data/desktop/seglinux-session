#!/bin/sh
# The SegLinux desktop: the Rust shell (dock, desktop icons, Start menu) on
# seglinux-compositor, SegLinux's own Rust compositor. Should it not start
# at all (an error within its first seconds), the same desktop comes up on
# labwc instead; `seglinux-session --labwc` ("SegLinux (labwc)" on the
# sign-in screen) always uses labwc.
set -eu
use_labwc=false
if [ "${1:-}" = --labwc ] || ! command -v seglinux-compositor >/dev/null 2>&1; then
    use_labwc=true
fi
export XDG_CURRENT_DESKTOP=SegLinux:wlroots
export XDG_SESSION_DESKTOP=seglinux
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
# Electron applications (Vesktop, Discord, VS Code) run on Wayland rather
# than through Xwayland: sharp text and working screen sharing.
export ELECTRON_OZONE_PLATFORM_HINT=auto
# Breeze cursors come with the breeze package (full edition); Adwaita's with GTK (Lite).
if [ -d /usr/share/icons/breeze_cursors ]; then
    export XCURSOR_THEME=breeze_cursors
else
    export XCURSOR_THEME=Adwaita
fi
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
# Without a working GPU driver (virtual machines without 3D acceleration,
# very new GPUs) Mesa only offers its software renderer, which wlroots
# refuses unless allowed. A real GPU is always preferred when there is one.
export WLR_RENDERER_ALLOW_SOFTWARE=1

# The keyboard layout chosen in Setup, which is written for X11: labwc only
# reads XKB_DEFAULT_LAYOUT. A layout set in SegLinux Settings (the
# compositor's environment file) takes precedence.
keyboard_conf=/etc/X11/xorg.conf.d/00-keyboard.conf
if [ -z "${XKB_DEFAULT_LAYOUT:-}" ] && [ -r "$keyboard_conf" ]; then
    layout=$(sed -n 's/^[[:space:]]*Option[[:space:]]*"XkbLayout"[[:space:]]*"\([^"]*\)".*/\1/p' "$keyboard_conf" | head -n 1)
    if [ -n "$layout" ]; then
        export XKB_DEFAULT_LAYOUT="$layout"
    fi
fi

# labwc reads its configuration from the user's folder, which SegLinux
# Settings writes when window or input settings change (and labwc then
# reloads). Until then its files link to the distribution's defaults.
system_labwc=/usr/share/seglinux/labwc
labwc_dir="${XDG_CONFIG_HOME:-$HOME/.config}/seglinux/labwc"
if mkdir -p "$labwc_dir" 2>/dev/null; then
    for file in rc.xml autostart themerc-override; do
        if [ ! -e "$labwc_dir/$file" ] && ! ln -sfn "$system_labwc/$file" "$labwc_dir/$file"; then
            labwc_dir=$system_labwc
            break
        fi
    done
else
    labwc_dir=$system_labwc
fi

run_labwc() {
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        dbus-run-session -- labwc -C "$labwc_dir"
    else
        labwc -C "$labwc_dir"
    fi
}

run_compositor() {
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        dbus-run-session -- seglinux-compositor --tty
    else
        seglinux-compositor --tty
    fi
}

if ! $use_labwc; then
    # SegLinux's own compositor: the desktop is just "SegLinux" (the
    # portals are chosen by seglinux-portals.conf, not by "wlroots").
    export XDG_CURRENT_DESKTOP=SegLinux
    started=$(date +%s)
    status=0
    run_compositor || status=$?
    # Signed out (0), or it ran a while and then failed: back to the
    # sign-in screen, as with labwc.
    if [ "$status" -eq 0 ] || [ $(($(date +%s) - started)) -ge 15 ]; then
        exit "$status"
    fi
    echo "seglinux-session: seglinux-compositor could not start (exit status $status); using labwc" >&2
    export XDG_CURRENT_DESKTOP=SegLinux:wlroots
fi

started=$(date +%s)
status=0
run_labwc || status=$?
# If the compositor could not start at all with OpenGL (it exits with an
# error right away; 126 and above mean "killed" or "not found"), try once
# more with wlroots' CPU renderer (pixman), which works on any display.
if [ "$status" -ge 1 ] && [ "$status" -le 125 ] && [ -z "${WLR_RENDERER:-}" ] &&
    [ $(($(date +%s) - started)) -lt 15 ]; then
    echo "seglinux-session: labwc could not start (exit status $status); retrying with WLR_RENDERER=pixman" >&2
    export WLR_RENDERER=pixman
    # Without GPU rendering, GTK draws faster on the CPU than through
    # Mesa's OpenGL emulation.
    export GSK_RENDERER="${GSK_RENDERER:-cairo}"
    run_labwc
    exit 0
fi
exit "$status"
