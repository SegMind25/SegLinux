#!/bin/sh
# labwc has now provided WAYLAND_DISPLAY and DISPLAY to its children.
dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
xdg-user-dirs-update
/usr/lib/seglinux/pipewire-session
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
if [ -x /usr/lib/seglinux/live-autostart ]; then
    /usr/lib/seglinux/live-autostart &
fi
# The desktop (wallpaper, dock, notifications), restarted if it ever crashes.
# It picks its own way of drawing (common.rs, shell_environment);
# applications and games keep using the GPU.
seglinux-shell &
