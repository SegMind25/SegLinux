#!/bin/bash
# seglinux-update: brings an installed SegLinux up to date without a new ISO:
# Artix's packages, Brave (from Chaotic-AUR) and SegLinux itself (from
# SegLinux's own signed repository on GitHub), then any application a newer
# SegLinux installs by default. Every package is signature-checked by pacman.
#
#   sudo seglinux-update                 upgrade everything
#   sudo seglinux-update --noconfirm     ... without questions (any pacman option)
#   sudo seglinux-update --setup         only set up the repositories (Setup)
#
# A system installed from an ISO older than this command gets it once with
# (docs/updating.md):
#   curl -fsSL https://raw.githubusercontent.com/SegMind25/SegLinux/main/data/system/seglinux-update -o /tmp/seglinux-update
#   sudo bash /tmp/seglinux-update
set -euo pipefail

updates=https://github.com/SegMind25/SegLinux/releases/download/packages
conf=/etc/pacman.conf
chaotic_key=3056513887B78AEB
chaotic_cdn=https://cdn-mirror.chaotic.cx/chaotic-aur
defaults=/usr/share/seglinux/default-apps
offered=/var/lib/seglinux/offered-apps

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWarning:\033[0m %s\n' "$*" >&2; }
die() { printf 'seglinux-update: %s\n' "$*" >&2; exit 1; }

has_repo() { grep -q "^\[$1\]" "$conf"; }

# Adds the repository $1, with the lines that follow, at the end of pacman.conf.
add_repo() {
    local name=$1
    shift
    cp -p "$conf" "$conf.before-seglinux-update"
    {
        printf '\n# Added by seglinux-update.\n[%s]\n' "$name"
        printf '%s\n' "$@"
    } >> "$conf"
}

# pacman's own key, which signing other keys needs; Setup creates it, but a
# system whose keyring was never set up (or was reset) has none.
ensure_keyring() {
    if [[ -z $(ls -A /etc/pacman.d/gnupg/private-keys-v1.d 2>/dev/null) ]]; then
        say "Setting up pacman's keyring"
        pacman-key --init
        pacman-key --populate
    fi
}

# Chaotic-AUR's key: from a key server, as Chaotic-AUR's instructions say
# (https://aur.chaotic.cx), or over HTTPS where key server ports are
# blocked. Only the key with this ID is then trusted (lsign).
receive_chaotic_key() {
    local server key
    pacman-key --list-keys "$chaotic_key" >/dev/null 2>&1 && return 0
    for server in hkps://keyserver.ubuntu.com hkp://keyserver.ubuntu.com:80; do
        pacman-key --recv-key "$chaotic_key" --keyserver "$server" && return 0
    done
    key=$(mktemp)
    if curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x$chaotic_key" -o "$key" &&
        pacman-key --add "$key"; then
        rm -f "$key"
        return 0
    fi
    rm -f "$key"
    return 1
}

# Brave and its updates: Chaotic-AUR. SegLinux images bring it already.
setup_chaotic() {
    if ! pacman -Q chaotic-keyring chaotic-mirrorlist >/dev/null 2>&1; then
        say "Setting up Chaotic-AUR, where Brave comes from"
        receive_chaotic_key || return 1
        pacman-key --lsign-key "$chaotic_key" || return 1
        # Its keyring needs archlinux-keyring: the package lists must be
        # there to find it (a system may never have downloaded them).
        pacman -Sy || return 1
        pacman -U --noconfirm --needed "$chaotic_cdn/chaotic-keyring.pkg.tar.zst" \
            "$chaotic_cdn/chaotic-mirrorlist.pkg.tar.zst" || return 1
    fi
    has_repo chaotic-aur || add_repo chaotic-aur "Include = /etc/pacman.d/chaotic-mirrorlist"
}

# SegLinux's own repository. Its key comes with the seglinux package; a
# SegLinux older than signed updates takes it from where the updates are
# published (over HTTPS, like the ISO), once. With $1 = offline, only the
# packaged key is used.
setup_seglinux() {
    local keyring=/usr/share/pacman/keyrings/seglinux.gpg key fpr
    if [[ -f $keyring ]]; then
        pacman-key --populate seglinux >/dev/null
    elif [[ ${1:-} == offline ]]; then
        return 0
    elif ! has_repo seglinux; then
        key=$(mktemp)
        if ! curl -fsSL "$updates/seglinux.gpg" -o "$key"; then
            rm -f "$key"
            warn "SegLinux's own updates are not published yet; updating everything else."
            return 0
        fi
        fpr=$(gpg --batch --show-keys --with-colons "$key" 2>/dev/null | awk -F: '/^fpr/ {print $10; exit}')
        [[ -n $fpr ]] || die "the SegLinux key from $updates is not a key"
        pacman-key --add "$key" >/dev/null
        pacman-key --lsign-key "$fpr" >/dev/null
        rm -f "$key"
    fi
    has_repo seglinux || add_repo seglinux "Server = $updates"
}

# Applications a newer SegLinux installs by default, offered once each: one
# removed on purpose is not installed again.
install_new_defaults() {
    [[ -f $defaults ]] || return 0
    mkdir -p "${offered%/*}"
    touch "$offered"
    local name wanted=()
    while read -r name; do
        [[ -z $name || $name == \#* ]] && continue
        grep -qxF "$name" "$offered" && continue
        pacman -Q "$name" >/dev/null 2>&1 || wanted+=("$name")
    done < "$defaults"
    if ((${#wanted[@]})); then
        say "New default applications: ${wanted[*]}"
        pacman -S --needed "$@" "${wanted[@]}" ||
            warn "Not installed. To install them later: sudo pacman -S ${wanted[*]}"
    fi
    awk 'NF && !/^#/' "$defaults" | sort -u - "$offered" -o "$offered"
}

# SegLinux's own sign-in screen (seglinux-greeter on greetd) replaced SDDM.
# A system installed before is asked once, interactively; the change takes
# effect at the next restart (OpenRC and dinit; runit: docs/desktop.md).
offer_sign_in_screen() {
    local init answer user autologin
    [[ -x /usr/bin/seglinux-greeter ]] || return 0
    if [[ -x /usr/bin/openrc-run ]]; then
        init=openrc
        [[ -e /etc/runlevels/default/sddm ]] || return 0
    elif [[ -d /etc/dinit.d/boot.d ]]; then
        init=dinit
        [[ -e /etc/dinit.d/boot.d/sddm ]] || return 0
    else
        return 0
    fi
    grep -qxF sign-in-screen "$offered" 2>/dev/null && return 0
    [[ -t 0 && " $* " != *" --noconfirm "* ]] || return 0
    say "SegLinux has a new sign-in screen of its own, in place of SDDM"
    read -r -p "Switch to it? It appears at the next restart. [Y/n] " answer || answer=n
    mkdir -p "${offered%/*}"
    echo sign-in-screen >> "$offered"
    if [[ $answer == [nN]* ]]; then
        echo "SDDM stays. To switch later, see docs/desktop.md (Sign-in screen)."
        return 0
    fi
    pacman -S --needed --noconfirm greetd "greetd-$init" || {
        warn "greetd could not be installed; SDDM stays."
        return 0
    }
    autologin=$(sed -n 's/^User=//p' /etc/sddm.conf.d/20-seglinux-autologin.conf 2>/dev/null | head -n 1)
    [[ -f /etc/greetd/config.toml ]] && cp -p /etc/greetd/config.toml /etc/greetd/config.toml.before-seglinux
    {
        cat /usr/share/seglinux/greeter/greetd.toml
        if [[ -n $autologin ]]; then
            printf '\n# %s was signed in automatically by SDDM.\n[initial_session]\ncommand = "seglinux-session"\nuser = "%s"\n' "$autologin" "$autologin"
        fi
    } > /etc/greetd/config.toml
    install -d -m 755 -o greeter -g greeter /var/lib/seglinux-greeter
    user=$(sed -n 's/^User=//p' /var/lib/sddm/state.conf 2>/dev/null | head -n 1)
    if [[ -n $user && ! -e /var/lib/seglinux-greeter/state.toml ]]; then
        printf 'user = "%s"\nsession = "seglinux"\n' "$user" > /var/lib/seglinux-greeter/state.toml
        chown greeter:greeter /var/lib/seglinux-greeter/state.toml
    fi
    case $init in
        openrc)
            rc-update del sddm default >/dev/null
            rc-update add greetd default >/dev/null
            ;;
        dinit)
            rm -f /etc/dinit.d/boot.d/sddm
            ln -sfn ../greetd /etc/dinit.d/boot.d/greetd
            ;;
    esac
    say "The new sign-in screen appears at the next restart (to go back: docs/desktop.md)."
}

main() {
    case ${1:-} in
        -h | --help)
            sed -n '2,15s/^# \{0,1\}//p' "$0"
            exit 0
            ;;
    esac
    [[ $EUID == 0 ]] || die "run it as root: sudo seglinux-update"

    if [[ ${1:-} == --setup ]]; then
        setup_seglinux offline
        exit 0
    fi

    if [[ -e /var/lib/pacman/db.lck ]]; then
        die "pacman is busy: another update (or Discover) is running. Wait for it to finish and try again. If nothing is running, remove the stale lock with: sudo rm /var/lib/pacman/db.lck"
    fi
    # Any answer at all means the network works (no -f).
    if ! curl -s --max-time 20 -o /dev/null https://github.com; then
        die "no internet connection (github.com cannot be reached). Connect, with Network in the dock or nmtui, and try again."
    fi

    ensure_keyring
    setup_chaotic || warn "Chaotic-AUR could not be set up, so Brave is not updated this time; everything else is."
    setup_seglinux
    say "Updating the system"
    pacman -Syu "$@"
    install_new_defaults "$@"
    offer_sign_in_screen "$@"
    say "SegLinux is up to date: $(pacman -Q seglinux 2>/dev/null || echo 'seglinux not installed')"
}

# Tests (ci.yml) source this file for its functions.
[[ ${BASH_SOURCE[0]} != "$0" ]] || main "$@"
