# Double-clicking a Windows program, installer or shortcut opens it with
# wcrun, which picks the Wine prefix, runner and graphics layers.
[Default Applications]
application/x-ms-dos-executable=wcrun.desktop
application/x-msdownload=wcrun.desktop
application/vnd.microsoft.portable-executable=wcrun.desktop
application/x-msi=wcrun.desktop
application/x-ms-shortcut=wcrun.desktop
application/x-bat=wcrun.desktop
