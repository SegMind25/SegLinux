#!/bin/sh
# Open the installed terminal emulator, optionally running a command:
#   wincraft-terminal [command [arguments...]]
# The full edition ships Konsole, the Lite edition foot.
for terminal in konsole foot alacritty xterm; do
    command -v "$terminal" >/dev/null 2>&1 || continue
    if [ $# -eq 0 ]; then
        exec "$terminal"
    fi
    case $terminal in
        foot) exec foot "$@" ;;
        *) exec "$terminal" -e "$@" ;;
    esac
done
echo "wincraft-terminal: no terminal emulator is installed" >&2
exit 1
