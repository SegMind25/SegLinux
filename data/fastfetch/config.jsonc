// fastfetch on SegLinux: SegLinux's logo and colours (fastfetch would show
// Artix's otherwise). A config of your own in ~/.config/fastfetch/ replaces
// this one: `fastfetch --gen-config` writes one to start from.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/seglinux/fastfetch/logo.txt",
    "color": {
      "1": "38;5;117",
      "2": "38;5;39",
      "3": "38;5;105"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "color": {
      "keys": "38;5;39",
      "title": "38;5;117"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "theme",
    "icons",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
