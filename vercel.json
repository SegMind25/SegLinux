{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": "site",
      "installCommand": "true",
      "buildCommand": "python3 -m pip install --target /tmp/seglinux-site-deps -r requirements.txt && PYTHONPATH=/tmp/seglinux-site-deps python3 build.py --out _site",
      "outputDirectory": "_site",
      "rewrites": [
        {
          "source": "/download",
          "destination": "/download.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "website"
      }
    }
  ],
  "headers": [
    {
      "source": "/releases.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/download-full.py",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"download-full.py\""
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
