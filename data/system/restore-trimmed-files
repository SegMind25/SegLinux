#!/bin/sh
# Wincraft Lite leaves documentation, translations, and firmware and
# drivers the live session does not use out of its image. Wincraft Setup
# runs this in the new system, after downloading the rest of Wincraft, to
# reinstall every package with missing files so that the installed system
# is complete. Needs a network connection.
set -eu

# Only packages from the repositories: wincraft itself is built locally.
foreign=$(pacman -Qmq || true)
pkgs=$(pacman -Qkq 2>/dev/null | cut -d' ' -f1 | sort -u)
if [ -n "$foreign" ] && [ -n "$pkgs" ]; then
    pkgs=$(printf '%s\n' "$pkgs" | grep -vxF "$foreign" || true)
fi
if [ -z "$pkgs" ]; then
    echo "Nothing to restore."
    exit 0
fi
echo "Reinstalling $(printf '%s\n' "$pkgs" | wc -l) packages with files left out of the Lite image"
# shellcheck disable=SC2086 # one argument per package
exec pacman -S --noconfirm $pkgs
