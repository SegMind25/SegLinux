# Maintainer: SegLinux contributors <https://github.com/SegMind25/SegLinux>
#
# Builds the SegLinux tools and defaults from this repository. The source
# tarball is produced by iso/scripts/build-in-container.sh (or by hand with
# `make -C packaging/seglinux source`); see docs/building.md.

pkgname=seglinux
pkgver=0.1.0
pkgrel=10
pkgdesc="SegLinux: lightweight Rust desktop, Windows program and game launcher, graphical installer and gaming tuning"
arch=('x86_64')
url="https://github.com/SegMind25/SegLinux"
# No license has been chosen for the SegLinux repository yet.
license=('LicenseRef-SegLinux-unspecified')
# Wine is optional so that the Lite edition's image stays small; its Setup
# downloads Wine with the rest of the full edition.
depends=('gcc-libs' 'glibc' 'procps-ng' 'gtk4' 'gtk4-layer-shell' 'labwc'
         'libinput' 'seatd' 'mesa' 'libxkbcommon' 'xorg-xwayland')
makedepends=('cargo' 'pkgconf')
optdepends=(
    'wine: run Windows programs (segrun)'
    'winetricks: install DXVK, VKD3D-Proton and Microsoft runtimes into prefixes'
    'steam: Proton for games'
    'dosbox: 16-bit DOS programs'
    'foot: terminal (seglinux-terminal)'
    'fastfetch: system information with the SegLinux logo when a terminal opens'
    'brave-bin: the default browser (AUR)'
    'foot: terminal (seglinux-terminal), Lite edition'
    'squashfs-tools: seglinux-setup (applies the system image)'
    'grub: seglinux-setup (boot manager)'
    'efibootmgr: seglinux-setup on UEFI machines'
    'dosfstools: seglinux-setup (EFI system partition)'
    'btrfs-progs: seglinux-setup with btrfs'
    'xfsprogs: seglinux-setup with xfs'
    'swaylock: screen locking in the Rust desktop'
    'pavucontrol: sound controls in the Rust desktop'
    'network-manager-applet: network connection editor'
    'wdisplays: Wayland display settings'
    'polkit-gnome: authentication agent in the SegLinux session'
    'xdg-desktop-portal-wlr: screen sharing in the Rust desktop'
    'xdg-desktop-portal-gtk: desktop file and URI portals'
    'grim: screenshots in the Rust desktop'
    'slurp: screenshots of an area in the Rust desktop'
    'gamemode: segrun runs games under GameMode'
    'mangohud: segrun --hud performance overlay'
    'gamescope: SegLinux Gaming Mode session and segrun --gamescope'
    'greetd: sign-in service for the SegLinux sign-in screen (seglinux-greeter)'
)
backup=(
    'etc/seglinux/segrun.toml'
    'etc/seglinux/greeter.toml'
    'etc/binfmt.d/wine.conf'
    'etc/sysctl.d/80-seglinux-gaming.conf'
    'etc/sysctl.d/81-seglinux-network.conf'
    'etc/makepkg.conf.d/10-seglinux.conf'
    'etc/xdg/xdg-desktop-portal-wlr/config'
    'etc/gamemode.ini'
    'etc/security/limits.d/90-seglinux-esync.conf'
    'etc/modules-load.d/10-ntsync.conf'
    'etc/modules-load.d/ddcutil.conf'
    'etc/sddm.conf.d/10-seglinux.conf'
    'etc/xdg/kdeglobals'
    'etc/xdg/mimeapps.list'
    'etc/xdg/fastfetch/config.jsonc'
    'etc/bash/bashrc.d/seglinux-fastfetch.bashrc'
    'etc/bash/bashrc.d/seglinux-rust-tools.bashrc'
)
# The project was called Wincraft before.
provides=('wincraft')
conflicts=('wincraft')
replaces=('wincraft')
install=seglinux.install
options=('!lto')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release
}

package() {
    cd "$pkgname-$pkgver"
    local data=data

    install -Dm755 target/release/segrun "$pkgdir/usr/bin/segrun"
    install -Dm755 target/release/seglinux-setup "$pkgdir/usr/bin/seglinux-setup"
    install -Dm755 target/release/seglinux-installer "$pkgdir/usr/bin/seglinux-installer"
    install -Dm644 crates/seglinux-setup/autounattend.example.toml \
        "$pkgdir/usr/share/seglinux/autounattend.example.toml"

    # SegLinux Rust desktop and its assets.
    install -Dm755 target/release/seglinux-shell "$pkgdir/usr/bin/seglinux-shell"
    install -Dm755 "$data/desktop/seglinux-session" "$pkgdir/usr/bin/seglinux-session"
    install -Dm755 "$data/system/seglinux-terminal" "$pkgdir/usr/bin/seglinux-terminal"

    # Upgrades: seglinux-upgrade (also seglinux-update, its former name), the
    # default applications it offers, and the
    # key SegLinux's packages are signed with (when the build had it: CI
    # writes it from the SEGLINUX_SIGNING_KEY secret, see docs/updating.md).
    install -Dm755 "$data/system/seglinux-upgrade" "$pkgdir/usr/bin/seglinux-upgrade"
    ln -s seglinux-upgrade "$pkgdir/usr/bin/seglinux-update"
    install -Dm644 "$data/seglinux/default-apps" "$pkgdir/usr/share/seglinux/default-apps"
    if [[ -f $data/keyrings/seglinux.gpg ]]; then
        install -Dm644 -t "$pkgdir/usr/share/pacman/keyrings" \
            "$data/keyrings/seglinux.gpg" "$data/keyrings/seglinux-trusted" "$data/keyrings/seglinux-revoked"
    fi
    # The sign-in screen, for greetd: the greeter, the labwc session it runs
    # in, its look, and the greetd configuration Setup installs.
    install -Dm755 target/release/seglinux-greeter "$pkgdir/usr/bin/seglinux-greeter"
    install -Dm755 "$data/greeter/seglinux-greeter-session" "$pkgdir/usr/bin/seglinux-greeter-session"
    install -Dm644 -t "$pkgdir/usr/share/seglinux/greeter/labwc" "$data/greeter/labwc/rc.xml" "$data/greeter/labwc/menu.xml"
    install -Dm644 "$data/greeter/greetd.toml" "$pkgdir/usr/share/seglinux/greeter/greetd.toml"
    install -Dm644 "$data/greeter/greeter.toml" "$pkgdir/etc/seglinux/greeter.toml"
    install -Dm644 "$data/desktop/seglinux.desktop" "$pkgdir/usr/share/wayland-sessions/seglinux.desktop"
    install -Dm755 "$data/desktop/seglinux-gaming-session" "$pkgdir/usr/bin/seglinux-gaming-session"
    install -Dm755 target/release/seglinux-compositor "$pkgdir/usr/bin/seglinux-compositor"
    install -Dm644 "$data/desktop/seglinux-labwc.desktop" "$pkgdir/usr/share/wayland-sessions/seglinux-labwc.desktop"
    install -Dm644 "$data/desktop/seglinux-gaming.desktop" "$pkgdir/usr/share/wayland-sessions/seglinux-gaming.desktop"
    install -Dm644 "$data/desktop/shell.toml" "$pkgdir/usr/share/seglinux/shell.example.toml"
    install -Dm644 "$data/desktop/seglinux-portals.conf" "$pkgdir/usr/share/xdg-desktop-portal/seglinux-portals.conf"
    install -Dm755 "$data/desktop/labwc/autostart" "$pkgdir/usr/share/seglinux/labwc/autostart"
    install -Dm644 -t "$pkgdir/usr/share/seglinux/labwc" "$data/desktop/labwc/rc.xml" "$data/desktop/labwc/themerc-override"
    install -Dm644 -t "$pkgdir/usr/share/backgrounds/seglinux" \
        "$data/artwork/seglinux-flow.jpg" "$data/artwork/seglinux-dark.jpg"
    install -Dm644 "$data/artwork/seglinux.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/seglinux.svg"

    # Boot menu theme, for the install media and installed systems.
    local theme=usr/share/grub/themes/seglinux
    install -Dm644 -t "$pkgdir/$theme" "$data"/grub/seglinux/*.{txt,jpg,png,pf2}
    install -Dm644 -t "$pkgdir/$theme/icons" "$data"/grub/seglinux/icons/*.png

    install -Dm644 "$data/xdg/kdeglobals" "$pkgdir/etc/xdg/kdeglobals"
    install -Dm644 "$data/xdg/mimeapps.list" "$pkgdir/etc/xdg/mimeapps.list"
    # Not /etc/xdg/foot/foot.ini: the foot package owns that file.
    install -Dm644 "$data/seglinux/foot.ini" "$pkgdir/usr/share/seglinux/foot.ini"
    install -Dm644 "$data/xdg/seglinux-pipewire.desktop" "$pkgdir/etc/xdg/autostart/seglinux-pipewire.desktop"
    install -Dm644 "$data/system/sddm-seglinux.conf" "$pkgdir/etc/sddm.conf.d/10-seglinux.conf"
    install -Dm644 -t "$pkgdir/usr/share/applications" "$data"/applications/*.desktop

    # Running Windows programs
    install -Dm644 "$data/seglinux/segrun.toml" "$pkgdir/etc/seglinux/segrun.toml"
    install -Dm644 "$data/system/binfmt-wine.conf" "$pkgdir/etc/binfmt.d/wine.conf"
    install -Dm644 "$data/system/sysctl-gaming.conf" "$pkgdir/etc/sysctl.d/80-seglinux-gaming.conf"
    install -Dm644 "$data/system/limits-esync.conf" "$pkgdir/etc/security/limits.d/90-seglinux-esync.conf"
    install -Dm644 "$data/system/modules-ntsync.conf" "$pkgdir/etc/modules-load.d/10-ntsync.conf"
    install -Dm644 "$data/system/sysctl-network.conf" "$pkgdir/etc/sysctl.d/81-seglinux-network.conf"
    install -Dm644 "$data/system/modules-network.conf" "$pkgdir/usr/lib/modules-load.d/seglinux-network.conf"
    install -Dm644 "$data/system/modules-zram.conf" "$pkgdir/usr/lib/modules-load.d/seglinux-zram.conf"
    install -Dm644 "$data/system/udev-zram.rules" "$pkgdir/usr/lib/udev/rules.d/60-seglinux-zram.rules"
    install -Dm755 "$data/system/zram-setup" "$pkgdir/usr/lib/seglinux/zram-setup"
    install -Dm644 "$data/system/makepkg-seglinux.conf" "$pkgdir/etc/makepkg.conf.d/10-seglinux.conf"
    install -Dm644 "$data/desktop/xdpw-config" "$pkgdir/etc/xdg/xdg-desktop-portal-wlr/config"
    install -Dm644 "$data/system/udev-ntsync.rules" "$pkgdir/usr/lib/udev/rules.d/70-seglinux-ntsync.rules"

    # Gaming and latency tuning
    install -Dm644 "$data/system/udev-ioschedulers.rules" "$pkgdir/usr/lib/udev/rules.d/60-seglinux-ioschedulers.rules"
    install -Dm644 "$data/system/modules-ddcutil.conf" "$pkgdir/etc/modules-load.d/ddcutil.conf"
    install -Dm644 "$data/system/modprobe-nowatchdog.conf" "$pkgdir/usr/lib/modprobe.d/seglinux-nowatchdog.conf"
    install -Dm644 "$data/system/modprobe-nvidia.conf" "$pkgdir/usr/lib/modprobe.d/seglinux-nvidia.conf"
    install -Dm644 "$data/system/gamemode.ini" "$pkgdir/etc/gamemode.ini"
    install -Dm644 "$data/system/profile-gaming.sh" "$pkgdir/etc/profile.d/seglinux-gaming.sh"

    # Setup and branding
    install -Dm644 "$data/seglinux/setupcomplete.d/README" "$pkgdir/etc/seglinux/setupcomplete.d/README"
    install -Dm644 "$data/system/os-release" "$pkgdir/usr/share/seglinux/os-release"
    # fastfetch with SegLinux's logo (not Artix's), when a terminal opens.
    install -Dm644 "$data/fastfetch/config.jsonc" "$pkgdir/etc/xdg/fastfetch/config.jsonc"
    install -Dm644 "$data/fastfetch/logo.txt" "$pkgdir/usr/share/seglinux/fastfetch/logo.txt"
    install -Dm644 "$data/system/fastfetch.bashrc" "$pkgdir/etc/bash/bashrc.d/seglinux-fastfetch.bashrc"
    install -Dm644 "$data/system/rust-tools.bashrc" "$pkgdir/etc/bash/bashrc.d/seglinux-rust-tools.bashrc"
    install -Dm755 "$data/system/apply-branding" "$pkgdir/usr/lib/seglinux/apply-branding"
    install -Dm755 "$data/system/pipewire-session" "$pkgdir/usr/lib/seglinux/pipewire-session"
    install -Dm755 "$data/system/restore-trimmed-files" "$pkgdir/usr/lib/seglinux/restore-trimmed-files"
    install -Dm644 "$data/libalpm/seglinux-branding.hook" "$pkgdir/usr/share/libalpm/hooks/seglinux-branding.hook"

    install -Dm644 -t "$pkgdir/usr/share/doc/seglinux" README.md docs/*.md
}
