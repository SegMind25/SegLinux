#!/bin/sh
# Live session: when an answer file (autounattend.toml) with
# auto_start = true is on the install media, a USB drive, the kernel command
# line or in /etc/seglinux, start the unattended installation, just as
# Windows Setup starts on its own when it finds autounattend.xml.
if sudo -n /usr/bin/seglinux-setup find-answer-file --require-autostart >/dev/null 2>&1; then
    exec seglinux-terminal sudo /usr/bin/seglinux-setup install --unattend
fi
