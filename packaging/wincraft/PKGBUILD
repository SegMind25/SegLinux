# Maintainer: Wincraft contributors <https://github.com/SegMind25/Wincraft>
#
# Builds the Wincraft tools and defaults from this repository. The source
# tarball is produced by iso/scripts/build-in-container.sh (or by hand with
# `make -C packaging/wincraft source`); see docs/building.md.

pkgname=wincraft
pkgver=0.1.0
pkgrel=4
pkgdesc="Wincraft: lightweight Rust desktop, Windows program and game launcher, installer and gaming tuning"
arch=('x86_64')
url="https://github.com/SegMind25/Wincraft"
# No license has been chosen for the Wincraft repository yet.
license=('LicenseRef-Wincraft-unspecified')
# Wine is optional so that the Lite edition's image stays small; its Setup
# downloads Wine with the rest of the full edition.
depends=('gcc-libs' 'glibc' 'procps-ng' 'gtk4' 'gtk4-layer-shell' 'labwc')
makedepends=('cargo' 'pkgconf')
optdepends=(
    'wine: run Windows programs (wcrun)'
    'winetricks: install DXVK, VKD3D-Proton and Microsoft runtimes into prefixes'
    'steam: Proton for games'
    'dosbox: 16-bit DOS programs'
    'konsole: terminal (wincraft-terminal), full edition'
    'foot: terminal (wincraft-terminal), Lite edition'
    'squashfs-tools: wincraft-setup (applies the system image)'
    'grub: wincraft-setup (boot manager)'
    'efibootmgr: wincraft-setup on UEFI machines'
    'dosfstools: wincraft-setup (EFI system partition)'
    'btrfs-progs: wincraft-setup with btrfs'
    'xfsprogs: wincraft-setup with xfs'
    'swaylock: screen locking in the Rust desktop'
    'pavucontrol: sound controls in the Rust desktop'
    'network-manager-applet: network connection editor'
    'wdisplays: Wayland display settings'
    'polkit-gnome: authentication agent in the Wincraft session'
    'xdg-desktop-portal-wlr: screen sharing in the Rust desktop'
    'xdg-desktop-portal-gtk: desktop file and URI portals'
    'gamemode: wcrun runs games under GameMode'
    'mangohud: wcrun --hud performance overlay'
    'gamescope: Wincraft Gaming Mode session and wcrun --gamescope'
)
backup=(
    'etc/wincraft/wcrun.toml'
    'etc/binfmt.d/wine.conf'
    'etc/sysctl.d/80-wincraft-gaming.conf'
    'etc/security/limits.d/90-wincraft-esync.conf'
    'etc/modules-load.d/ntsync.conf'
    'etc/sddm.conf.d/10-wincraft.conf'
    'etc/xdg/kdeglobals'
    'etc/xdg/kwinrc'
    'etc/xdg/mimeapps.list'
)
install=wincraft.install
options=('!lto')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release
}

package() {
    cd "$pkgname-$pkgver"
    local data=data

    install -Dm755 target/release/wcrun "$pkgdir/usr/bin/wcrun"
    install -Dm755 target/release/wincraft-setup "$pkgdir/usr/bin/wincraft-setup"
    install -Dm644 crates/wincraft-setup/autounattend.example.toml \
        "$pkgdir/usr/share/wincraft/autounattend.example.toml"

    # Wincraft Rust desktop and its assets.
    install -Dm755 target/release/wincraft-shell "$pkgdir/usr/bin/wincraft-shell"
    install -Dm755 "$data/desktop/wincraft-session" "$pkgdir/usr/bin/wincraft-session"
    install -Dm755 "$data/system/wincraft-terminal" "$pkgdir/usr/bin/wincraft-terminal"
    install -Dm644 "$data/desktop/wincraft.desktop" "$pkgdir/usr/share/wayland-sessions/wincraft.desktop"
    install -Dm755 "$data/desktop/wincraft-gaming-session" "$pkgdir/usr/bin/wincraft-gaming-session"
    install -Dm644 "$data/desktop/wincraft-gaming.desktop" "$pkgdir/usr/share/wayland-sessions/wincraft-gaming.desktop"
    install -Dm644 "$data/desktop/shell.toml" "$pkgdir/usr/share/wincraft/shell.example.toml"
    install -Dm644 "$data/desktop/wincraft-portals.conf" "$pkgdir/usr/share/xdg-desktop-portal/wincraft-portals.conf"
    install -Dm755 "$data/desktop/labwc/autostart" "$pkgdir/usr/share/wincraft/labwc/autostart"
    install -Dm644 -t "$pkgdir/usr/share/wincraft/labwc" "$data/desktop/labwc/rc.xml" "$data/desktop/labwc/themerc-override"
    install -Dm644 "$data/artwork/wincraft-dark.png" "$pkgdir/usr/share/backgrounds/wincraft/wincraft-dark.png"
    install -Dm644 "$data/artwork/wincraft.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/wincraft.svg"

    # Windows-style Plasma desktop
    local lnf=usr/share/plasma/look-and-feel/org.wincraft.desktop
    install -Dm644 "$data/plasma/look-and-feel/org.wincraft.desktop/metadata.json" "$pkgdir/$lnf/metadata.json"
    install -Dm644 "$data/plasma/look-and-feel/org.wincraft.desktop/contents/defaults" "$pkgdir/$lnf/contents/defaults"
    install -Dm644 "$data/plasma/look-and-feel/org.wincraft.desktop/contents/layouts/org.kde.plasma.desktop-layout.js" \
        "$pkgdir/$lnf/contents/layouts/org.kde.plasma.desktop-layout.js"
    install -Dm644 "$data/xdg/kdeglobals" "$pkgdir/etc/xdg/kdeglobals"
    install -Dm644 "$data/xdg/kwinrc" "$pkgdir/etc/xdg/kwinrc"
    install -Dm644 "$data/xdg/mimeapps.list" "$pkgdir/etc/xdg/mimeapps.list"
    install -Dm644 "$data/xdg/wincraft-pipewire.desktop" "$pkgdir/etc/xdg/autostart/wincraft-pipewire.desktop"
    install -Dm644 "$data/system/sddm-wincraft.conf" "$pkgdir/etc/sddm.conf.d/10-wincraft.conf"
    install -Dm644 -t "$pkgdir/usr/share/applications" "$data"/applications/*.desktop

    # Running Windows programs
    install -Dm644 "$data/wincraft/wcrun.toml" "$pkgdir/etc/wincraft/wcrun.toml"
    install -Dm644 "$data/system/binfmt-wine.conf" "$pkgdir/etc/binfmt.d/wine.conf"
    install -Dm644 "$data/system/sysctl-gaming.conf" "$pkgdir/etc/sysctl.d/80-wincraft-gaming.conf"
    install -Dm644 "$data/system/limits-esync.conf" "$pkgdir/etc/security/limits.d/90-wincraft-esync.conf"
    install -Dm644 "$data/system/modules-ntsync.conf" "$pkgdir/etc/modules-load.d/ntsync.conf"
    install -Dm644 "$data/system/udev-ntsync.rules" "$pkgdir/usr/lib/udev/rules.d/70-wincraft-ntsync.rules"

    # Gaming and latency tuning
    install -Dm644 "$data/system/udev-ioschedulers.rules" "$pkgdir/usr/lib/udev/rules.d/60-wincraft-ioschedulers.rules"
    install -Dm644 "$data/system/modprobe-nowatchdog.conf" "$pkgdir/usr/lib/modprobe.d/wincraft-nowatchdog.conf"

    # Setup and branding
    install -Dm644 "$data/wincraft/setupcomplete.d/README" "$pkgdir/etc/wincraft/setupcomplete.d/README"
    install -Dm644 "$data/system/os-release" "$pkgdir/usr/share/wincraft/os-release"
    install -Dm755 "$data/system/apply-branding" "$pkgdir/usr/lib/wincraft/apply-branding"
    install -Dm755 "$data/system/pipewire-session" "$pkgdir/usr/lib/wincraft/pipewire-session"
    install -Dm644 "$data/libalpm/wincraft-branding.hook" "$pkgdir/usr/share/libalpm/hooks/wincraft-branding.hook"

    install -Dm644 -t "$pkgdir/usr/share/doc/wincraft" README.md docs/*.md
}
