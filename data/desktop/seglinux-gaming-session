#!/bin/sh
# SegLinux Gaming Mode: Steam's Big Picture inside gamescope, like SteamOS'
# Gaming Mode. Leaving Big Picture ends the session and returns to the
# sign-in screen, where the SegLinux desktop can be chosen again.
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=seglinux-gaming
export XDG_SESSION_TYPE=wayland
/usr/lib/seglinux/pipewire-session
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- gamescope -e --adaptive-sync -- steam -gamepadui
fi
exec gamescope -e --adaptive-sync -- steam -gamepadui
