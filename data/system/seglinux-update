#!/bin/bash
# seglinux-update: brings an installed SegLinux up to date without a new ISO:
# Artix's packages, Brave (from Chaotic-AUR) and SegLinux itself (from
# SegLinux's own signed repository on GitHub), then any application a newer
# SegLinux installs by default. Every package is signature-checked by pacman.
#
#   sudo seglinux-update                 upgrade everything
#   sudo seglinux-update --noconfirm     ... without questions (any pacman option)
#   sudo seglinux-update --setup         only set up the repositories (Setup)
#
# A system installed from an ISO older than this command gets it once with
# (docs/updating.md):
#   curl -fsSL https://raw.githubusercontent.com/SegMind25/SegLinux/main/data/system/seglinux-update -o /tmp/seglinux-update
#   sudo bash /tmp/seglinux-update
set -euo pipefail

updates=https://github.com/SegMind25/SegLinux/releases/download/packages
conf=/etc/pacman.conf
chaotic_key=3056513887B78AEB
chaotic_cdn=https://cdn-mirror.chaotic.cx/chaotic-aur
defaults=/usr/share/seglinux/default-apps
offered=/var/lib/seglinux/offered-apps

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
die() { printf 'seglinux-update: %s\n' "$*" >&2; exit 1; }

has_repo() { grep -q "^\[$1\]" "$conf"; }

# Adds the repository $1, with the lines that follow, at the end of pacman.conf.
add_repo() {
    local name=$1
    shift
    cp -p "$conf" "$conf.before-seglinux-update"
    {
        printf '\n# Added by seglinux-update.\n[%s]\n' "$name"
        printf '%s\n' "$@"
    } >> "$conf"
}

# Brave and its updates: Chaotic-AUR, set up as its own instructions say
# (https://aur.chaotic.cx). SegLinux images bring it already.
setup_chaotic() {
    if ! pacman -Q chaotic-keyring chaotic-mirrorlist >/dev/null 2>&1; then
        say "Setting up Chaotic-AUR, where Brave comes from"
        pacman-key --recv-key "$chaotic_key" --keyserver keyserver.ubuntu.com
        pacman-key --lsign-key "$chaotic_key"
        pacman -U --noconfirm "$chaotic_cdn/chaotic-keyring.pkg.tar.zst" "$chaotic_cdn/chaotic-mirrorlist.pkg.tar.zst"
    fi
    has_repo chaotic-aur || add_repo chaotic-aur "Include = /etc/pacman.d/chaotic-mirrorlist"
}

# SegLinux's own repository. Its key comes with the seglinux package; a
# SegLinux older than signed updates takes it from where the updates are
# published (over HTTPS, like the ISO), once. With $1 = offline, only the
# packaged key is used.
setup_seglinux() {
    local keyring=/usr/share/pacman/keyrings/seglinux.gpg key fpr
    if [[ -f $keyring ]]; then
        pacman-key --populate seglinux >/dev/null
    elif [[ ${1:-} == offline ]]; then
        return 0
    else
        key=$(mktemp)
        if ! curl -fsSL "$updates/seglinux.gpg" -o "$key"; then
            rm -f "$key"
            echo "SegLinux's own updates are not published yet; updating everything else." >&2
            return 0
        fi
        fpr=$(gpg --batch --show-keys --with-colons "$key" | awk -F: '/^fpr/ {print $10; exit}')
        [[ -n $fpr ]] || die "the SegLinux key from $updates is not a key"
        pacman-key --add "$key" >/dev/null
        pacman-key --lsign-key "$fpr" >/dev/null
        rm -f "$key"
    fi
    has_repo seglinux || add_repo seglinux "Server = $updates"
}

# Applications a newer SegLinux installs by default, offered once each: one
# removed on purpose is not installed again.
install_new_defaults() {
    [[ -f $defaults ]] || return 0
    mkdir -p "${offered%/*}"
    touch "$offered"
    local name wanted=()
    while read -r name; do
        [[ -z $name || $name == \#* ]] && continue
        grep -qxF "$name" "$offered" && continue
        pacman -Q "$name" >/dev/null 2>&1 || wanted+=("$name")
    done < "$defaults"
    if ((${#wanted[@]})); then
        say "New default applications: ${wanted[*]}"
        pacman -S --needed "$@" "${wanted[@]}" ||
            echo "Not installed. To install them later: sudo pacman -S ${wanted[*]}" >&2
    fi
    awk 'NF && !/^#/' "$defaults" | sort -u - "$offered" -o "$offered"
}

case ${1:-} in
    -h | --help)
        sed -n '2,15s/^# \{0,1\}//p' "$0"
        exit 0
        ;;
esac
[[ $EUID == 0 ]] || die "run it as root: sudo seglinux-update"

if [[ ${1:-} == --setup ]]; then
    setup_seglinux offline
    exit 0
fi

setup_chaotic
setup_seglinux
say "Updating the system"
pacman -Syu "$@"
install_new_defaults "$@"
say "SegLinux is up to date."
