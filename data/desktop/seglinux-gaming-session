#!/bin/sh
# SegLinux Gaming Mode: Steam's Big Picture inside gamescope, like SteamOS'
# Gaming Mode. Leaving Big Picture ends the session and returns to the
# sign-in screen, where the SegLinux desktop can be chosen again.
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=seglinux-gaming
export XDG_SESSION_TYPE=wayland
/usr/lib/seglinux/pipewire-session

# gamescope's options from SegLinux Settings (Gaming → Gaming Mode): one per
# line, numbers and flags only. Without the desktop, the usual defaults.
options="-e
--adaptive-sync"
if command -v seglinux-shell >/dev/null 2>&1 &&
    configured=$(seglinux-shell --gaming-mode-args 2>/dev/null) && [ -n "$configured" ]; then
    options=$configured
fi
set -f
IFS='
'
# shellcheck disable=SC2086 # one option per line, split on purpose
set -- $options
unset IFS
set +f

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- gamescope "$@" -- steam -gamepadui
fi
exec gamescope "$@" -- steam -gamepadui
