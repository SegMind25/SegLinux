# Double-clicking a Windows program, installer or shortcut opens it with
# segrun, which picks the Wine prefix, runner and graphics layers.
[Default Applications]
application/x-ms-dos-executable=segrun.desktop
application/x-msdownload=segrun.desktop
application/vnd.microsoft.portable-executable=segrun.desktop
application/x-msi=segrun.desktop
application/x-ms-shortcut=segrun.desktop
application/x-bat=segrun.desktop
