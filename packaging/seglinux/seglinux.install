# The key SegLinux's updates are signed with, once pacman has a keyring
# (SegLinux Setup creates the installed system's).
trust_update_key() {
    if [[ -f /usr/share/pacman/keyrings/seglinux.gpg && -d /etc/pacman.d/gnupg ]]; then
        pacman-key --populate seglinux >/dev/null 2>&1 || true
    fi
}

# Where the sign-in screen remembers the last account and desktop; greetd's
# greeter user must be able to write it.
greeter_state() {
    if getent passwd greeter >/dev/null 2>&1; then
        install -d -m 755 -o greeter -g greeter /var/lib/seglinux-greeter 2>/dev/null || true
    fi
}

# The copies of seglinux-upgrade that its one-time download leaves on
# systems older than it (/usr/local/bin, first in the PATH) would hide this
# package's.
retire_update_copy() {
    local copy
    for copy in /usr/local/bin/seglinux-upgrade /usr/local/bin/seglinux-update; do
        if [[ -L $copy ]] || { [[ -f $copy ]] && grep -q '^# seglinux-up\(date\|grade\): ' "$copy"; }; then
            rm -f "$copy"
        fi
    done
}

# SegLinux always asks for the password at startup now. Older Setups could
# sign in by themselves (SDDM's [Autologin], greetd's [initial_session]):
# that is removed once, the files kept in /var/lib/seglinux/autologin-backup.
# Not on the live USB, which signs in by itself.
sign_in_with_password() {
    local done=/var/lib/seglinux/autologin-removed backup=/var/lib/seglinux/autologin-backup
    local file section
    [[ -e $done || -d /run/artix/bootmnt ]] && return 0
    for file in /etc/greetd/config.toml /etc/sddm.conf /etc/sddm.conf.d/*.conf; do
        [[ -f $file ]] || continue
        case $file in
            /etc/greetd/*) section='[initial_session]' ;;
            *) section='[Autologin]' ;;
        esac
        grep -qxF "$section" "$file" || continue
        install -d -m 700 "$backup"
        cp -p "$file" "$backup/${file//\//_}"
        # The section, and the comments Setup wrote about it.
        awk -v section="$section" '
            /^\[/ { skip = ($0 == section) }
            /^# Setup: .* is signed in/ || /^# signing out shows the sign-in screen/ ||
                /^# .* was signed in automatically/ { next }
            !skip
        ' "$backup/${file//\//_}" > "$file"
        echo "==> Automatic sign-in turned off: the password is asked at startup ($file)."
    done
    mkdir -p "${done%/*}"
    touch "$done"
}

post_install() {
    /usr/lib/seglinux/apply-branding
    trust_update_key
    greeter_state
    retire_update_copy
    cat <<'MSG'
==> Windows programs: double-click an .exe, or run `segrun program.exe`.
==> `segrun doctor` checks Wine, Vulkan, NTSYNC and binfmt support.
MSG
}

# The network settings at once, not only after a restart: buffers and
# congestion control now; NetworkManager reads the Wi-Fi power setting
# when it reconnects (the card's driver options apply after a restart).
apply_network() {
    sysctl -q -p /etc/sysctl.d/81-seglinux-network.conf >/dev/null 2>&1 || true
    if command -v nmcli >/dev/null 2>&1; then
        nmcli general reload conf >/dev/null 2>&1 || true
    fi
}

post_upgrade() {
    /usr/lib/seglinux/apply-branding
    apply_network
    trust_update_key
    greeter_state
    retire_update_copy
    sign_in_with_password
}
