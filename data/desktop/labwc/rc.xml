<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>server</decoration><gap>8</gap>
    <!-- Gaming: variable refresh rate (FreeSync/G-Sync) for fullscreen
         windows, and tearing when a game asks for it, for the lowest
         input latency. -->
    <adaptiveSync>fullscreen</adaptiveSync>
    <allowTearing>yes</allowTearing>
  </core>
  <theme>
    <name>Wincraft</name><cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>Noto Sans</name><size>10</size></font>
    <titlebar><layout>icon:iconify,max,close</layout></titlebar>
  </theme>
  <keyboard>
    <default />
    <keybind key="W-space"><action name="Execute" command="gapplication action org.wincraft.Shell menu" /></keybind>
    <keybind key="W-e"><action name="Execute" command="dolphin" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="wincraft-terminal" /></keybind>
    <keybind key="W-l"><action name="Execute" command="swaylock -c 090f1d" /></keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
  </keyboard>
  <mouse><default /></mouse>
  <windowSwitcher preview="yes"><osd show="yes" /></windowSwitcher>
</labwc_config>
