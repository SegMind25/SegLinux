#!/bin/sh
# Open the installed terminal emulator, optionally running a command:
#   seglinux-terminal [command [arguments...]]
# kitty is SegLinux's terminal; the Lite live session has foot.
for terminal in kitty konsole foot alacritty xterm; do
    command -v "$terminal" >/dev/null 2>&1 || continue
    if [ $# -eq 0 ]; then
        exec "$terminal"
    fi
    case $terminal in
        kitty | foot) exec "$terminal" "$@" ;;
        *) exec "$terminal" -e "$@" ;;
    esac
done
echo "seglinux-terminal: no terminal emulator is installed" >&2
exit 1
